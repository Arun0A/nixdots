[global]
    monitor = 0
    follow = mouse
    width = 212
    height = 100
    offset = 0x20
    origin = top-right
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    shrink = no
    separator_height = 2
    padding = 5
    horizontal_padding = 5
    frame_width = 1
    frame_color = "#9c9c9c"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = Monospace 9
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    icon_position = left
    max_icon_size = 32

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#383f4c"
    foreground = "#c4c4bc"
    timeout = 3

[urgency_normal]
    background = "#383f4c"
    foreground = "#c4c4bc"
    timeout = 5

[urgency_critical]
    background = "#bb3f3f"
    foreground = "#f4efef"
    frame_color = "#bb3f3f"
    timeout = 0
